# ╔══════════════════════════════════════════════════════════════╗
# ║  ICF — Inteligência Centralizada de Feedbacks              ║
# ║  Variáveis de ambiente para docker-compose                 ║
# ╚══════════════════════════════════════════════════════════════╝
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=icf_user
POSTGRES_PASSWORD=icf_pass
POSTGRES_DB=icf_db
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379

# ── Evolution API (WhatsApp) ────────────────────────────────
# Chave de autenticação obrigatória para a Evolution API
EVOLUTION_API_KEY=sua_chave_evolution_aqui
EVOLUTION_PORT=8080

# ── Backend (NestJS) ───────────────────────────────────────
BACKEND_PORT=3001

# Anthropic / Claude — necessária para categorização por IA
ANTHROPIC_API_KEY=sk-ant-...

# Jira Service Management
JIRA_BASE_URL=https://seu-dominio.atlassian.net
JIRA_EMAIL=seu_email@empresa.com
JIRA_API_TOKEN=seu_token_jira_aqui
JIRA_PROJECT_KEY=PROJ

# Webhook
WEBHOOK_SECRET=gere_um_segredo_forte_aqui

# ── Frontend (Vite + React) ────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001
