# Application
PORT=3000

# Feature flags
FEATURE_JIRA_ENABLED=true
FEATURE_AI_ENABLED=false
FEATURE_EVOLUTION_ENABLED=false

# Database (PostgreSQL - Docker)
DATABASE_URL=postgresql://prisma:prisma123@localhost:5433/prisma?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Jira (Atlassian)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email_here
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=PROJ

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Webhook
WEBHOOK_SECRET=
